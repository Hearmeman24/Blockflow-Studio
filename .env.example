# Provider API keys are entered in Settings, not here.

# ---- Ports ----
# BACKEND_PORT=47301
# FRONTEND_PORT=47300

# ---- User data ----
# BLOCKFLOW_DATA_DIR=                 # Override where flows, outputs and run history live

# ---- Features ----
# BLOCKFLOW_ADVANCED=1                # Enable advanced mode

# ---- Video FX (frame interpolation) ----
# RIFE_BIN=                           # Path to the rife-ncnn-vulkan binary
# RIFE_MODEL_DIR=                     # Path to the RIFE model directory
